<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>SteamVR2Bot</AssemblyName>
    <RootNamespace>SvrBridge.Tray</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>assets\SteamVR2Bot.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SvrBridge.Core\SvrBridge.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Combining UseWindowsForms with UseWPF changes which namespaces the SDK
      adds implicitly - it drops System.IO and System.Net.Http rather than
      merging them in, which would otherwise silently break every existing
      file that used File/Directory/Path/InvalidDataException unqualified.
      Restored explicitly so the WinForms-only implicit surface this codebase
      was written against does not change underneath it.
    -->
    <Using Include="System.IO" />
    <Using Include="System.Net.Http" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\SvrBridge\assets\actions.json" Link="actions.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\SvrBridge\assets\bindings_vive_controller.json" Link="bindings_vive_controller.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\SvrBridge\assets\bindings_index_controller.json" Link="bindings_index_controller.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\SvrBridge\assets\bindings_oculus_touch.json" Link="bindings_oculus_touch.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\SvrBridge\assets\app.vrmanifest" Link="app.vrmanifest" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\SvrBridge\assets\SteamVR2Bot.png" Link="SteamVR2Bot.png" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\SvrBridge\appsettings.example.json" Link="appsettings.example.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Platform icons for the notification event picker's source chips, looked
      up by the source name GetEvents reports - see SourceIconResource. A
      glob rather than a list of files on purpose: the picker must not carry a
      hardcoded platform list, so adding a logo is dropping a PNG in here with
      no code change, and shipping none at all (the state this ships in) is
      simply every source drawing its coloured text chip instead. Embedded
      rather than copied beside the exe because these are chrome, not user
      assets, and a missing file must not be a thing that can happen at run
      time.
    -->
    <EmbeddedResource Include="assets\source-icons\*.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
  </ItemGroup>
</Project>
