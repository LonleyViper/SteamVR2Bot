<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>SteamVR2Bot</AssemblyName>
    <RootNamespace>SvrBridge.Tray</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SvrBridge.Core\SvrBridge.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\SvrBridge\assets\actions.json" Link="actions.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\SvrBridge\assets\bindings_vive_controller.json" Link="bindings_vive_controller.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\SvrBridge\assets\app.vrmanifest" Link="app.vrmanifest" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\SvrBridge\appsettings.example.json" Link="appsettings.example.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
