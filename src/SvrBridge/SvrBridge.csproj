<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>SteamVR2Bot.Diagnostics</AssemblyName>
    <RootNamespace>SvrBridge</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SvrBridge.Core\SvrBridge.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="assets\actions.json" Link="actions.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="assets\bindings_vive_controller.json" Link="bindings_vive_controller.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="assets\app.vrmanifest" Link="app.vrmanifest" CopyToOutputDirectory="PreserveNewest" />
    <None Include="appsettings.example.json" Link="appsettings.example.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
